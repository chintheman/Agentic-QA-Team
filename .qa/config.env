# QA team configuration. Environment variables take precedence, so CI and the
# self-tests can override without editing this file.
QA_ADAPTER="${QA_ADAPTER:-}"          # blank => auto-detect via .qa/adapters/detect.sh
QA_DEFAULT_BRANCH="${QA_DEFAULT_BRANCH:-main}"
QA_MUTATION_THRESHOLD="${QA_MUTATION_THRESHOLD:-0.60}"   # G2; ratchet up monthly, never down
QA_MUTATION_TIMEOUT_SECONDS="${QA_MUTATION_TIMEOUT_SECONDS:-900}"  # G2 hard wall-clock cap
QA_PR_BUDGET_USD="${QA_PR_BUDGET_USD:-8.00}"             # G6 per-PR cap
QA_MUTATION_JSON="${QA_MUTATION_JSON:-$QA_ROOT/.qa/metrics/mutation.json}"
